# Copy this file to .env and fill in the values. Never commit .env.

# Neon connection string (Neon console > your project > Connect, "pooled" connection)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Long random string, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# http://localhost:5173 locally, your Vercel URL in production
BETTER_AUTH_URL="http://localhost:5173"
